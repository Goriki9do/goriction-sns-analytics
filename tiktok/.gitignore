# ダウンロードしたCSVの実データ。手元にのみ置く。
exports/*
!exports/.gitkeep
!exports/inbox/
exports/inbox/*
!exports/inbox/.gitkeep
!exports/processed/
exports/processed/*
!exports/processed/.gitkeep
!exports/downloads_processed/
exports/downloads_processed/*
!exports/downloads_processed/.gitkeep

